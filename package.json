{
  "name": "versova-bot",
  "version": "1.0.0",
  "description": "◢禍◣ Versova ࿙☕࿚ — VÉRSOVA: bot de WhatsApp para administración de teams de rol + panel web de gestión de sub-bots.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "bot": "node src/index.js --no-web",
