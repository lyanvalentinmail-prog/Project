    "sim": "node tools/simulator.js",
    "test": "node --test --test-concurrency=1",
    "db:inspect": "node scripts/db-inspect.js",
    "db:reset": "node scripts/db-reset.js",
    "doctor": "node scripts/doctor.js",
    "test:watch": "node --test --watch --test-concurrency=1"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "rol",
    "roleplay",
    "versova",
    "team-management"
