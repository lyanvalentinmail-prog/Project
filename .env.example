# ════════════════════════════════════════════════════════════════
#  𓆩 ☕ 𓆪  VÉRSOVA — configuración de entorno  𓆩 ☕ 𓆪
#  Copia este archivo a `.env` y edítalo. NUNCA subas `.env` a git.
# ════════════════════════════════════════════════════════════════

# ── IDENTIDAD DEL BOT ───────────────────────────────────────────
BOT_NAME=VÉRSOVA
BOT_TEAM=◢禍◣ Versova ࿙☕࿚
BOT_PREFIX=.
BOT_VERSION=1.0

# ── PROPIETARIO ─────────────────────────────────────────────────
# Números del dueño del bot, en formato internacional SIN "+", separados por coma.
# Ejemplo: 5215512345678,5491122334455
# El owner tiene acceso total en cualquier grupo y no puede ser expulsado/baneado.
OWNER_NUMBERS=5215500000000

# ── PANEL WEB ───────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Contraseña del panel. Si la dejas vacía se genera una aleatoria y se imprime en consola al iniciar.
DASHBOARD_PASSWORD=
# Sub-bots simultáneos permitidos (máximo recomendado por estabilidad: 3)
MAX_INSTANCES=3

# ── BASE DE DATOS ───────────────────────────────────────────────
DB_PATH=./data/versova.db

# ── SESIONES DE WHATSAPP (creds) ────────────────────────────────
SESSIONS_DIR=./sessions

# ── COMPORTAMIENTO ──────────────────────────────────────────────
# Días sin actividad para considerar a alguien inactivo (editable también con .config inactividad N)
INACTIVITY_DAYS=7
# Horas que dura una reserva de personaje
RESERVE_HOURS=24
# Advertencias máximas antes de expulsión automática
MAX_WARNINGS=3
# Anti-spam: comandos permitidos por ventana
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW_MS=10000
# Bienvenida / despedida automáticas (true|false)
WELCOME_ENABLED=true
# Responder también en chats privados (true|false)
PRIVATE_COMMANDS=true

# ── LOGS ────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/versova.log
