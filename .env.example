# ════════════════════════════════════════════════════════════════
#  VÉRSOVA · configuración de entorno
#  Copia este archivo a `.env` y edítalo. NUNCA subas `.env` a git.
# ════════════════════════════════════════════════════════════════

# ── IDENTIDAD ─────────────────────────────────────────────────
BOT_NAME=VÉRSOVA
BOT_TEAM=◢禍◣ Versova ࿙☕࿚
BOT_PREFIX=.
BOT_VERSION=1.0

# ── PROPIETARIO ───────────────────────────────────────────────
OWNER_NUMBERS=5215500000000

# ── PANEL WEB ─────────────────────────────────────────────────
# 0.0.0.0 = accesible desde tu red · 127.0.0.1 = solo desde este equipo/teléfono
WEB_HOST=0.0.0.0
# En Android (Termux) el puerto debe ser 1024 o mayor.
WEB_PORT=3000
# El panel NO pide contraseña: está abierto por diseño.
MAX_INSTANCES=3

# ── BASE DE DATOS ─────────────────────────────────────────────
DB_PATH=./data/versova.db
# Motor SQLite. «auto» usa better-sqlite3 si está instalado y, si no, el
# SQLite integrado en Node ≥ 22.13 (es lo que se usa en Termux/Android).
# DB_DRIVER=auto
# Diario de SQLite: WAL por defecto; si el sistema de archivos no lo
# soporta, se cambia solo a DELETE.
# DB_JOURNAL_MODE=WAL

# ── SESIONES DE WHATSAPP ──────────────────────────────────────
SESSIONS_DIR=./sessions

# ── COMPORTAMIENTO ────────────────────────────────────────────
INACTIVITY_DAYS=7
RESERVE_HOURS=24
MAX_WARNINGS=3
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW_MS=10000
WELCOME_ENABLED=true
PRIVATE_COMMANDS=true

# ── LOGS ──────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/versova.log

# ── TERMINAL (Termux / SSH) ───────────────────────────────────
# Los pairing codes siempre se muestran en la consola. El QR se dibuja
# con caracteres solo si la salida es una terminal; true lo fuerza y
# false lo desactiva.
# TERMINAL_QR=auto
# Segundos entre reinicios automáticos de «npm run termux» si el bot se cae.
# RESTART_DELAY=5
